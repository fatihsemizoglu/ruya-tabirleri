{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/ruya-tabirleri",
      "destination": "/populer",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://dagjpitlouekbnwdcpbz.supabase.co/functions/v1/$1"
    },
    {
      "source": "/ruya/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/kategori/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/az/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    { "source": "/ara", "destination": "/index.html" },
    { "source": "/karsilastir", "destination": "/index.html" },
    { "source": "/kategoriler", "destination": "/index.html" },
    { "source": "/populer", "destination": "/index.html" },
    { "source": "/akis", "destination": "/index.html" },
    { "source": "/az", "destination": "/index.html" },
    { "source": "/profil", "destination": "/index.html" },
    { "source": "/ruya-gunlugum", "destination": "/index.html" },
    { "source": "/ruya-gunlugum/sesli", "destination": "/index.html" },
    { "source": "/favorilerim", "destination": "/index.html" },
    { "source": "/gecmis", "destination": "/index.html" },
    { "source": "/hakkimizda", "destination": "/index.html" },
    { "source": "/iletisim", "destination": "/index.html" },
    { "source": "/gizlilik", "destination": "/index.html" },
    { "source": "/kullanim-kosullari", "destination": "/index.html" },
    { "source": "/kvkk", "destination": "/index.html" },
    { "source": "/cerez-politikasi", "destination": "/index.html" },
    { "source": "/sss", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/yukle", "destination": "/index.html" },
    { "source": "/ruyami-yorumlat", "destination": "/index.html" },
    { "source": "/istatistikler", "destination": "/index.html" },
    { "source": "/abonelik-dogrula", "destination": "/index.html" },
    { "source": "/abonelik-iptal", "destination": "/index.html" },
    { "source": "/giris", "destination": "/index.html" },
    { "source": "/kayit", "destination": "/index.html" },
    { "source": "/sifremi-unuttum", "destination": "/index.html" },
    { "source": "/sifre-sifirla", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/email-dogrula", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), interest-cohort=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.supabase.co https://www.googletagmanager.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.resend.com https://o0.ingest.sentry.io https://*.sentry.io https://*.ingest.sentry.io; frame-src 'self' https://www.openstreetmap.org https://www.google.com https://maps.google.com https://yandex.com.tr https://*.yandex.com.tr https://yandex.com https://*.yandex.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ],
  "crons": []
}
